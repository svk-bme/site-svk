---
import { Image } from 'astro:assets'
import GoogleForm from '~/components/GoogleForm.astro'
import { formatDate, localePath, md, t, tr, type Locale } from '~/i18n'
import BaseLayout from '~/layouts/BaseLayout.astro'
import { calendarPath, eventEnd, eventWebsite, registrationForm, type Event } from '~/lib/events'
import { buildTime, settings } from '~/lib/site'

interface Props {
  locale: Locale
  event: Event
}

const { locale, event } = Astro.props
const { image, image_alt, start, end, place, speaker, album_link } = event.data
const website = eventWebsite(event)
const form = registrationForm(event)
const title = tr(locale, event.data.title)
const description = md(locale, event.data.description)
const tz = settings.timezone
const sameDay = end && formatDate(locale, start, tz, { time: false }) === formatDate(locale, end, tz, { time: false })
const endText = end
  ? sameDay
    ? new Intl.DateTimeFormat(t(locale, 'meta.intl'), { timeZone: tz, timeStyle: 'short' }).format(end)
    : formatDate(locale, end, tz)
  : undefined
// Registration is shown until the event starts (Google Forms' "Accepting responses" closes it earlier)
const registration = form && start > buildTime
// "Add to calendar" only until the event ends
const upcoming = eventEnd(event) > buildTime
---

<BaseLayout
  locale={locale}
  title={title}
  description={tr(locale, event.data.description).slice(0, 200) || undefined}
  image={image?.src}
  noindex={event.data.draft}
>
  <article class="section container">
    <p><a href={localePath(locale, '/events')}>← {t(locale, 'events.back')}</a></p>
    <div class="event-detail">
      <div>
        <h1>{title}</h1>
        <dl class="meta">
          <dt>{t(locale, 'events.when')}</dt>
          <dd>
            <time datetime={start.toISOString()}>{formatDate(locale, start, tz)}</time>
            {endText && <> – <time datetime={eventEnd(event).toISOString()}>{endText}</time></>}
          </dd>
          {place && (
            <>
              <dt>{t(locale, 'events.where')}</dt>
              <dd>{tr(locale, place)}</dd>
            </>
          )}
          {speaker && (
            <>
              <dt>{t(locale, 'events.speaker')}</dt>
              <dd>{tr(locale, speaker)}</dd>
            </>
          )}
        </dl>
        <p class="links">
          {registration && (
            <a class="button" href="#registration">
              {t(locale, 'events.registration')}
            </a>
          )}
          {website && (
            <a class="button button--secondary" href={website} target="_blank" rel="noopener">
              {t(locale, 'events.external')} ↗
            </a>
          )}
          {upcoming && (
            <a class="button button--secondary" href={calendarPath(locale, event)} download={`${event.id}.ics`}>
              {t(locale, 'events.addToCalendar')}
            </a>
          )}
          {album_link && (
            <a class="button button--secondary" href={album_link} target="_blank" rel="noopener">
              {t(locale, 'events.album')} ↗
            </a>
          )}
        </p>
      </div>
      {
        image && (
          <Image
            src={image}
            alt={tr(locale, image_alt)}
            widths={[400, 800, 1200]}
            sizes="(min-width: 60rem) 40vw, 90vw"
            loading="eager"
            class="event-detail__image"
          />
        )
      }
    </div>
    {description && <div class="prose section" set:html={description} />}
    {
      registration && (
        <section class="section" id="registration" aria-labelledby="registration-title">
          <h2 id="registration-title">{t(locale, 'events.registration')}</h2>
          <GoogleForm locale={locale} kind="event-registration" url={form} title={`${t(locale, 'events.registration')}: ${title}`} />
        </section>
      )
    }
  </article>
</BaseLayout>
